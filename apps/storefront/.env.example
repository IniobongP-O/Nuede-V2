# Public browser-safe values. Do not put secrets in any VITE_ variable.
# Use the same intended backend as admin; see docs/DEPLOYMENT.md for deployment gates.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# PUBLIC, OPTIONAL WHILE VERCEL_PROJECT_PRODUCTION_URL SUPPLIES THE STABLE PROJECT DOMAIN.
# Set this to the permanent HTTPS root origin once a custom canonical domain is configured.
VITE_PUBLIC_SITE_URL=

# PUBLIC, OPTIONAL, NOT A SECRET.
VITE_GOOGLE_SITE_VERIFICATION=

# Optional approved contact details; leave unset until the business supplies them.
# General WhatsApp contact is independent of the checkout payment setting.
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
VITE_CONTACT_INSTAGRAM=
VITE_CONTACT_HOURS=
