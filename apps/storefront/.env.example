# Public browser-safe values. Vercel production builds reject placeholders and backend secrets.
# Use the same intended backend as admin; see docs/DEPLOYMENT.md for deployment gates.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional approved contact details; leave unset until the business supplies them.
# General WhatsApp contact is independent of the checkout payment setting.
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
VITE_CONTACT_INSTAGRAM=
VITE_CONTACT_HOURS=
