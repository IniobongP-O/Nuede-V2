# Public browser-safe values consumed by the admin Auth client.
# Use the same intended backend as storefront; Vercel production rejects placeholders.
# Never add a service-role key, password, access token, or refresh token here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
